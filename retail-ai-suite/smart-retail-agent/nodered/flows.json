[
    {
        "id": "flow_main",
        "type": "tab",
        "label": "Store Dashboard",
        "disabled": false,
        "info": "Retail store employee vs customer count dashboard"
    },
    {
        "id": "mqtt_broker",
        "type": "mqtt-broker",
        "name": "SceneScape Broker",
        "broker": "broker.scenescape.intel.com",
        "port": "1883",
        "tls": "tls_config",
        "clientid": "nodered-dashboard",
        "autoConnect": true,
        "usetls": true,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "sessionExpiry": ""
    },
    {
        "id": "tls_config",
        "type": "tls-config",
        "name": "SceneScape TLS",
        "cert": "",
        "key": "",
        "ca": "/run/secrets/certs/scenescape-ca.pem",
        "certname": "",
        "keyname": "",
        "caname": "scenescape-ca.pem",
        "servername": "",
        "verifyservercert": false,
        "alpnprotocol": ""
    },
    {
        "id": "dashboard_tab",
        "type": "ui_tab",
        "name": "Store Metrics",
        "icon": "dashboard",
        "order": 1,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "group_counts",
        "type": "ui_group",
        "name": "People Counts",
        "tab": "dashboard_tab",
        "order": 1,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "mqtt_scene_sub",
        "type": "mqtt in",
        "z": "flow_main",
        "name": "Scene Data",
        "topic": "scenescape/data/scene/+/+",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 120,
        "wires": [["parse_counts"]]
    },
    {
        "id": "parse_counts",
        "type": "function",
        "z": "flow_main",
        "name": "Count Employees vs Customers",
        "func": "var objects = msg.payload.objects || [];\nvar employeeCount = 0;\nvar customerCount = 0;\n\nobjects.forEach(function(obj) {\n    var isEmployee = false;\n    if (obj.sensors && obj.sensors.Employee_Register && Array.isArray(obj.sensors.Employee_Register) && obj.sensors.Employee_Register.length > 0) {\n        isEmployee = true;\n    }\n    if (isEmployee) {\n        employeeCount++;\n    } else {\n        customerCount++;\n    }\n});\n\nvar totalCount = objects.length;\n\nvar msg1 = { payload: employeeCount };\nvar msg2 = { payload: customerCount };\nvar msg3 = { payload: totalCount };\n\nreturn [msg1, msg2, msg3];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 120,
        "wires": [["gauge_employee"], ["gauge_customer"], ["gauge_total"]]
    },
    {
        "id": "gauge_employee",
        "type": "ui_gauge",
        "z": "flow_main",
        "name": "Employees",
        "group": "group_counts",
        "order": 1,
        "width": "4",
        "height": "4",
        "gtype": "gage",
        "title": "Employees",
        "label": "",
        "format": "{{value}}",
        "min": 0,
        "max": "20",
        "colors": ["#00b500","#e6e600","#ca3838"],
        "seg1": "",
        "seg2": "",
        "className": "",
        "x": 680,
        "y": 60,
        "wires": []
    },
    {
        "id": "gauge_customer",
        "type": "ui_gauge",
        "z": "flow_main",
        "name": "Customers",
        "group": "group_counts",
        "order": 2,
        "width": "4",
        "height": "4",
        "gtype": "gage",
        "title": "Customers",
        "label": "",
        "format": "{{value}}",
        "min": 0,
        "max": "50",
        "colors": ["#00b4e6","#e6e600","#ca3838"],
        "seg1": "",
        "seg2": "",
        "className": "",
        "x": 680,
        "y": 120,
        "wires": []
    },
    {
        "id": "gauge_total",
        "type": "ui_gauge",
        "z": "flow_main",
        "name": "Total People",
        "group": "group_counts",
        "order": 3,
        "width": "4",
        "height": "4",
        "gtype": "gage",
        "title": "Total People",
        "label": "",
        "format": "{{value}}",
        "min": 0,
        "max": "50",
        "colors": ["#a0a0a0","#e6e600","#ca3838"],
        "seg1": "",
        "seg2": "",
        "className": "",
        "x": 680,
        "y": 180,
        "wires": []
    }
]

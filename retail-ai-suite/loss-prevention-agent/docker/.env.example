# Loss Prevention Agent environment variables
# Copy to .env and adjust values as needed.

# ---- Host ----
HOST_IP=

# ---- Proxy ----
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1

# ---- Store ----
STORE_NAME=retail_store_1
STORE_ID=store_001

# ---- MQTT (SceneScape broker) ----
MQTT_HOST=broker.scenescape.intel.com
MQTT_PORT=1883

# ---- VLM ----
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct
VLM_COMPRESSION_WEIGHT_FORMAT=int4
VLM_DEVICE=CPU
VLM_WORKERS=1
VLM_MAX_COMPLETION_TOKENS=500
HUGGINGFACE_TOKEN=

# ---- MinIO ----
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Agent ----
LP_AGENT_PORT=8082
LOG_LEVEL=INFO

# ---- SceneScape API (zone auto-discovery) ----
SCENESCAPE_API_USER=scenectrl
SCENESCAPE_API_PASSWORD=

# ---- Device group IDs (check with `id` command) ----
USER_GROUP_ID=1000
VIDEO_GROUP_ID=44
RENDER_GROUP_ID=109

{
  "store": {
    "name": "retail_store_1",
    "id": "store_001"
  },
  "cameras": [
    {
      "name": "camera1",
      "number": 1,
      "description": "Electronics aisle",
      "data_topic": "scenescape/data/camera/camera1",
      "image_topic": "scenescape/image/camera/camera1"
    },
    {
      "name": "camera2",
      "number": 2,
      "description": "Checkout lanes",
      "data_topic": "scenescape/data/camera/camera2",
      "image_topic": "scenescape/image/camera/camera2"
    }
  ],
  "mqtt": {
    "host": "broker.scenescape.intel.com",
    "port": 1883,
    "use_tls": true,
    "cert_required": false,
    "verify_hostname": false,
    "ca_cert_path": "secrets/certs/scenescape-ca.pem",
    "scene_data_topic_pattern": "scenescape/data/scene/+/+",
    "region_event_topic_pattern": "scenescape/event/region/+/+/+",
    "image_topic_pattern": "scenescape/image/camera/+",
    "cmd_topic_pattern": "scenescape/cmd/camera/{camera_name}",
    "alert_topic_prefix": "lp/alerts"
  },
  "minio": {
    "endpoint": "minio:9000",
    "access_key": "minioadmin",
    "secret_key": "minioadmin",
    "secure": false,
    "bucket_frames": "frames",
    "bucket_thumbnails": "thumbnails",
    "bucket_evidence": "evidence",
    "retention_hours": 24
  },
  "vlm": {
    "base_url": "http://vlm-openvino-serving:8000",
    "model": "Qwen/Qwen2.5-VL-3B-Instruct",
    "timeout_seconds": 300,
    "max_completion_tokens": 500,
    "temperature": 0.1,
    "top_p": 0.1
  },
  "pose": {
    "model": "human-pose-estimation-0001",
    "confidence_threshold": 0.5,
    "window_size": 10,
    "waist_proximity_threshold": 0.10
  },
  "rules": {
    "loiter_threshold_seconds": 120,
    "repeat_visit_threshold": 3,
    "session_timeout_seconds": 30,
    "vlm_confidence_threshold": 0.80,
    "vlm_log_threshold": 0.50,
    "analysis_fps": 2
  }
}
